<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <PZModId>WrenchKillTally</PZModId>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="KillTally.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Wrench.Api" Version="$(WrenchApiVersion)" ExcludeAssets="runtime" />
        <PackageReference Include="Wrench.Game.Java" Version="$(WrenchGameJavaVersion)" ExcludeAssets="runtime" />
    </ItemGroup>

</Project>
