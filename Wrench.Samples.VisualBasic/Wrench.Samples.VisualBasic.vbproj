<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <RootNamespace>Wrench.Samples.VisualBasic</RootNamespace>
        <IsPackable>false</IsPackable>
        <OptionStrict>On</OptionStrict>
        <OptionInfer>On</OptionInfer>
        <PZModId>WrenchWeighIt</PZModId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Wrench.Api" Version="$(WrenchApiVersion)" ExcludeAssets="runtime" />
        <PackageReference Include="Wrench.Game.Java" Version="$(WrenchGameJavaVersion)" ExcludeAssets="runtime" />
        <PackageReference Include="Wrench.Game.Lua" Version="$(WrenchGameLuaVersion)" ExcludeAssets="runtime" />
    </ItemGroup>

</Project>
