<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <RootNamespace>Wrench.Samples.VisualBasic</RootNamespace>
        <IsPackable>false</IsPackable>
        <OptionStrict>On</OptionStrict>
        <OptionInfer>On</OptionInfer>
        <PZModId>WrenchWeighIt</PZModId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wrench.Api\Wrench.Api.csproj" Private="false" />
        <ProjectReference Include="..\Wrench.Game.Java\Wrench.Game.Java.csproj" Private="false" />
        <ProjectReference Include="..\Wrench.Game.Lua\Wrench.Game.Lua.csproj" Private="false" />
    </ItemGroup>

    <Import Project="..\build\Wrench.PzMod.targets" />

</Project>
