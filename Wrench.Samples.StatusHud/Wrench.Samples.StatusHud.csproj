<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <PZModId>WrenchStatusHud</PZModId>
    </PropertyGroup>

    <ItemGroup>
        <!-- Provided by Wrench.Host at runtime; a mod must not ship its own copy. -->
        <PackageReference Include="Wrench.Api" Version="$(WrenchApiVersion)" ExcludeAssets="runtime" />
        <PackageReference Include="Wrench.Game.Java" Version="$(WrenchGameJavaVersion)" ExcludeAssets="runtime" />
        <PackageReference Include="Wrench.Game.Lua" Version="$(WrenchGameLuaVersion)" ExcludeAssets="runtime" />
    </ItemGroup>

</Project>
